{
  "name": "makereadyos-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "db:generate": "prisma generate",
    "db:push": "prisma db push --skip-generate",
    "db:deploy": "prisma migrate deploy",
    "db:migrate": "prisma migrate dev",
    "seed": "tsx src/seed.ts",
    "seed:large": "tsx src/seedLarge.ts",
    "automations:run": "tsx src/runScheduledAutomations.ts",
    "analytics:snapshot": "tsx src/runAnalyticsSnapshot.ts",
    "webhooks:run": "tsx src/runWebhookDeliveries.ts",
    "uploads:route-existing": "tsx src/routeExistingUploads.ts"
  },
  "dependencies": {
    "@fastify/cookie": "11.0.0",
    "@fastify/cors": "^11.3.0",
    "@fastify/multipart": "^9.4.0",
    "@prisma/client": "^6.8.2",
    "csv-stringify": "^6.8.3",
    "fastify": "^5.11.2",
    "nodemailer": "^9.0.4",
    "puppeteer-core": "^24.43.1",
    "yazl": "^3.3.1",
    "zod": "^3.25.28",
    "zod-to-json-schema": "^3.25.2"
  },
  "overrides": {
    "fast-uri": "^3.1.5",
    "find-my-way": "^9.7.0",
    "ip-address": "^10.4.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "@types/nodemailer": "^6.4.24",
    "@types/yazl": "^3.3.1",
    "prisma": "^6.8.2",
    "tsx": "^4.23.9",
    "typescript": "^5.8.3"
  }
}
