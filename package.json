{
  "name": "makereadyos",
  "private": true,
  "version": "0.1.0",
  "license": "AGPL-3.0-only",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "lint": "eslint apps/web/src --max-warnings=0",
    "dev": "concurrently \"npm --prefix apps/api run dev\" \"npm --prefix apps/web run dev\"",
    "build": "npm --prefix apps/api run build && npm --prefix apps/web run build",
    "seed": "npm --prefix apps/api run seed",
    "e2e": "playwright test"
  },
  "overrides": {
    "minimatch@>=7 <11.0.1": "11.0.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@typescript-eslint/parser": "^8.72.2",
    "concurrently": "^10.0.7",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1"
  }
}
